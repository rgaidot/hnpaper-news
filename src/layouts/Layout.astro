---
import '../styles/global.css';
import { pwaInfo } from 'virtual:pwa-info';
import PostHogAnalytics from '../components/PostHogAnalytics.astro';
import Search from '../components/Search.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script is:inline>
      window['__onGCastApiAvailable'] = function(isAvailable) {
        if (isAvailable) {
          window.castAvailable = true;
          window.dispatchEvent(new Event('google-cast-available'));
        }
      };
      (function() {
        var script = document.createElement('script');
        script.src = 'https://www.gstatic.com/cv/js/sender/v1/cast_sender.js?loadCastFramework=1';
        script.async = true;
        document.body.appendChild(script);
      })();
    </script>
    <PostHogAnalytics />
    <title>{title}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <header class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-3 text-center">
      <div class="border-b-4 border-stone-900 pb-1 mb-1">
        <h1
          class="font-serif text-4xl sm:text-6xl md:text-7xl font-black tracking-tighter text-stone-900 uppercase leading-none"
        >
          <a href="/" class="hover:text-stone-700 transition-colors"
            >The HNPaper</a
          >
        </h1>
      </div>
      <div
        class="py-1 flex justify-between items-center gap-3 font-serif font-bold text-xs sm:text-sm uppercase tracking-widest text-stone-800"
      >
        <Search />
        <nav class="shrink-0">
          <a href="/archives" class="hover:underline">Archives</a>
        </nav>
      </div>
    </header>

    <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-6">
      <slot />
    </main>

    <footer
      class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 mt-12 mb-12 border-t-4 border-stone-900"
    >
      <div class="text-center font-serif text-sm text-stone-600">
        <nav class="mb-6 flex justify-center gap-6 font-bold uppercase tracking-widest text-stone-900">
          <a href="/" class="hover:underline">Accueil</a>
          <a href="/list" class="hover:underline">Liste</a>
          <a href="/archives" class="hover:underline">Archives</a>
        </nav>
        <p class="mb-2">
          &copy; {new Date().getFullYear()} HNPaper News.
        </p>
        <p>
          <a
            href="https://hnpaper-labs.gaidot.net"
            target="_blank"
            class="text-stone-900 hover:underline font-bold">HNPaper</a
          >
          &mdash; <a
            href="https://voxify-labs.gaidot.net/"
            target="_blank"
            class="text-stone-900 hover:underline font-bold">Voxify</a
          >
          &mdash; By <a
            href="https://regis.gaidot.net"
            target="_blank"
            class="text-stone-900 hover:underline font-bold">Régis Gaidot</a
          >
        </p>
      </div>
    </footer>

    <script>
      import { registerSW } from "virtual:pwa-register";
      registerSW({ immediate: true });
    </script>
  </body>
</html>
